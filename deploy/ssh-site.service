[Unit]
Description=DevOps Daily SSH app
Documentation=https://github.com/The-DevOps-Daily/devops-daily-cli
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/ssh-site
EnvironmentFile=/etc/ssh-site/ssh-site.env
Environment=GOMEMLIMIT=200MiB
Restart=always
RestartSec=2
TimeoutStopSec=10

# A throwaway user per run; the host key and feed cache live in the state
# directory (/var/lib/ssh-site), which survives restarts and upgrades.
DynamicUser=yes
StateDirectory=ssh-site
StateDirectoryMode=0700
UMask=0077

# Only what binding port 22 needs.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

MemoryMax=256M
MemorySwapMax=0
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
